# Copy to .env (local) or paste into Railway → Variables. Never commit the real .env.

# Database. On Railway use:  DATABASE_URL=${{MySQL.MYSQL_URL}}
# Leave empty locally to use a SQLite file.
DATABASE_URL=

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Public address of the app, no trailing slash. Used for OAuth redirect URLs.
PUBLIC_URL=http://localhost:8000

# Load demo jobs, candidates and employees on first start (true/false)
SEED_DEMO=true

# Required on the HR sign-up page when set, so only your company can create HR accounts
COMPANY_CODE=

APP_TIMEZONE=Asia/Kolkata

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft sign-in ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Phone sign-in (SMS codes via Twilio) ----
# Leave Twilio empty to run in demo mode, where the code is shown on screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_DEMO_MODE=true
DEFAULT_COUNTRY_CODE=+91

# ---- Email notifications (optional; e.g. Gmail with an App Password) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: path to IBM HR Analytics CSV to train the attrition model on real data
ATTRITION_CSV=
